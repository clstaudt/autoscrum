# -- LLM defaults (apply to all agent roles) ---------------------------------
# Uses LiteLLM model strings: openai/gpt-4o, anthropic/claude-sonnet-4-..., etc.
AUTOSCRUM_LLM=openai/gpt-4o
# AUTOSCRUM_BASE_URL=          # Custom endpoint (oMLX, vLLM, Ollama, etc.)
#                              # Automatically sets OPENAI_API_BASE for you.

# -- API keys ----------------------------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# For OpenAI-compatible servers (oMLX, vLLM, etc.) that don't require auth,
# set OPENAI_API_KEY to any non-empty value:
# OPENAI_API_KEY=not-needed

# Optional: Serper for web search tools
SERPER_API_KEY=
